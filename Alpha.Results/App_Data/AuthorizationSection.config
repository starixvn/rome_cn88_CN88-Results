<?xml version="1.0" encoding="utf-8" ?>
<AuthorizationSection
  fullpermission="[B],[D],[E],[H]"
  custIdQueryStringParamNameMapping="custid"
  custIdJsonParamNameMapping=""
  cachedExpireTime="30"
  kickOutUrl="~/auth/kickout">
  <!--
    [B]: Account Management Edit & View
    [D]: Total Bets
    [E]: Reports
    [H]: Account Management View Only
  -->
  <GroupPageAccess roleid="2" name="Agent">
    <PageAccesses>
      <add id="1.01.01" permission="[D]" mainfuncname="Normal" subfuncname="Normal" url="Normal/Index" ischeckbelonging="true" />
      <add id="1.01.02" permission="[D]" mainfuncname="Outright" subfuncname="Normal" url="Outright/Index" ischeckbelonging="true" />
    </PageAccesses>
  </GroupPageAccess>

  <GroupPageAccess roleid="3" name="Master">
    <PageAccesses>
    </PageAccesses>
  </GroupPageAccess>

  <GroupPageAccess roleid="4" name="Super">
    <PageAccesses>
    </PageAccesses>
  </GroupPageAccess>
  
</AuthorizationSection>