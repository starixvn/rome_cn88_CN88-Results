<!DOCTYPE html>
<html class="ifr-result">
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@Html.Raw(ViewBag.Title)</title>
    <link href="" rel="stylesheet" />
    @CN88.Web.Helpers.StaticResources.AssetStyles.Render("/bundles/common/common")
    @CN88.Web.Helpers.StaticResources.AssetStyles.Render("/bundles/site-results/default")
    @RenderSection("ComponentStyles", false)
    @Styles.Render(BundleConfig.ResultCoreStyleBundleUrl)
    @RenderSection("Styles", false)
</head>
<body @(Html.Raw(CN88.Web.Helpers.BrowserManager.BuildMobileHtmlClass()))>
    <div id="page_main">
        <div id="page_main">
            <div class="container-fluid">
                <div class="">
                    @Html.Action("Index", "Tab", new { tabName = ViewContext.RouteData.Values["controller"], area = "" })
                    <div class="tab-content">
                        @RenderBody()
                    </div>
                </div>
            </div>
        </div>
    </div>
    @Html.Hidden("RootURL", HttpContext.Current.Response.ApplyAppPathModifier("~/"))
    @CN88.Web.Helpers.StaticResources.AssetScripts.Render("/bundles/site-results/default")
    @RenderSection("Scripts", false)
    @CN88.Web.Helpers.GoogleAnalyticHepler.Render()
</body>
</html>