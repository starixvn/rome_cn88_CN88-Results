@{
    ViewBag.Title = "Outright";
}

@section ComponentStyles
{
    <link href="/contents/components/datetimepicker/css/bootstrap-datetimepicker.min.css" rel="stylesheet" />
}

@model OutrightResultViewModel

@section styles
{
    <link href="/contents/components/select2/css/select2.min.css" rel="stylesheet" />
}

<div role="tabpanel" class="tab-pane active" id="outright">
    <div class="filter">
        @using (Html.BeginForm("Index", "Outright", FormMethod.Get, new { id = "frm-outright" }))
        {
            <div>
                <div class="form-group">
                    <label class="txt">@Resources.From</label>
                    <div class="control date">
                        <div class="input-group date" id="dpk-fromdate">
                            <input class="form-control text-box single-line" data-val="true" data-val-date="The field FromDate must be a date." data-val-required="The FromDate field is required." id="FromDate" name="FromDate" readonly="readonly" type="datetime" value="@Model.FromDate.ToCN88ShortDateFormat()" />
                            <span class="input-group-addon">
                                <span class="icon-calendar"></span>
                            </span>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="txt">@Resources.To</label>
                    <div class="control date">
                        <div class="input-group date" id="dpk-todate">
                            <input class="form-control text-box single-line" data-val="true" data-val-date="The field ToDate must be a date." data-val-required="The ToDate field is required." id="ToDate" name="ToDate" readonly="readonly" type="datetime" value="@Model.ToDate.ToCN88ShortDateFormat()" />
                            <span class="input-group-addon">
                                <span class="icon-calendar"></span>
                            </span>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <input type="submit" value="@Resources.Submit" class="btn-submit" id="btn-submit" />
                </div>
            </div>
            if (Model.Sports != null && Model.Sports.Any())
            {
                <div class="sport-info">
                    <div class="form-group">
                        <label class="txt">@Resources.Sport</label>
                        <div class="dropdown control sport-content">
                            @Html.DropDownListFor(model => model.SportType, Model.Sports, new { @class = "form-control", @onchange = "this.form.submit()" })
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="txt">@Resources.League</label>
                        <div class="dropdown control league-content">
                            @Html.DropDownListFor(model => model.LeagueId, Model.Leagues, Resources.ShowAllLeagues, new { @class = "form-control", @onchange = "this.form.submit()" })
                        </div>
                    </div>

                    <span class="icon-excel" id="btn-excel"></span>
                </div>
            }
        }
    </div>
    <div class="main-content">
        @Html.Raw(Model.HtmlResults)
    </div>
    <input data-val="true" data-val-date="The field MinResultDate must be a date." data-val-required="The MinResultDate field is required." id="MinResultDate" name="MinResultDate" type="hidden" value="@Model.MinResultDate.ToCN88ShortDateFormat()" />
    <input data-val="true" data-val-date="The field MaxResultDate must be a date." data-val-required="The MaxResultDate field is required." id="MaxResultDate" name="MaxResultDate" type="hidden" value="@Model.MaxResultDate.ToCN88ShortDateFormat()" />
</div>
<iframe src="#" frameborder="0" scrolling="no" id="ifrm-exportExcel" name="ifrm-exportExcel" style="display:none;"></iframe>

@section scripts
{
    @Scripts.Render(BundleConfig.OutrightResultJavascriptBundleUrl)
}