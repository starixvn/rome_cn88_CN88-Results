@{
    ViewBag.Title = "Normal";
}

@model NormalResultViewModel


<div role="tabpanel" class="tab-pane active" id="normal">
    <div class="row filter">
        @using (Html.BeginForm("Index", "Normal", FormMethod.Get, new { @id = "result-filter" }))
        {
            <div class="col-sm-12 main-option">
                <div class="form-group">
                    <label class="txt">@Resources.Date</label>
                    <div class="control date">
                        <div class="input-group date" id="dpkContainer">
                            @Html.EditorFor(model => model.ResultDate, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                            <span class="input-group-addon">
                                <span class="icon-calendar"></span>
                            </span>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <input type="submit" value="@Resources.Submit" id="selected-day-results" class="btn-submit" />
                    <input type="submit" value="@Model.Today.ToShortDateFormatWithSlash()" id="today-results" class="btn-default btn-other-day" />
                    <input type="submit" value="@Model.Yesterday.ToShortDateFormatWithSlash()" id="yesterday-results" class="btn-default btn-other-day" />
                </div>
            </div>
            <div class="col-sm-12">
                <span class="txt-red">*</span> @Model.MinResultDateMessage
            </div>

            if (Model.Sports.Any())
            {
                <div class="col-sm-12 sport-info">
                    <div class="form-group">
                        <label class="txt">@Resources.Sport</label>
                        <div class="dropdown control">
                            @Html.DropDownListFor(model => model.SportId, Model.Sports, new { @class = "form-control" })
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="txt">@Resources.League</label>
                        <div class="dropdown control league-content">
                            @Html.DropDownListFor(model => model.LeagueId, Model.Leagues, Resources.ShowAllLeagues, new { @class = "form-control", @onchange = "this.form.submit()" })
                        </div>
                    </div>
                    <span class="icon-excel" id="excel-btn"></span>
                </div>
            }
        }
    </div>

    <div class="main-content" id="main-result">
        @Html.Raw(Model.HtmlResults)
    </div>
    @Html.HiddenFor(model => model.MinResultDate)
    @Html.HiddenFor(model => model.Today)
</div>

<div class="modal fade" id="result-details" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="result-detailt-title"></h4>
        </div>

        <div class="modal-body" id="detail-result-body">
            <img id="loading-image" src="~/Content/Images/ajax-loader.gif" />
            <iframe src="about:blank" frameborder="0" scrolling="yes" height="400px" id="result-detail-frm" name="result-detail-frm" style="display:none;width:100%;"></iframe>
        </div>
    </div>
    </div>
</div>

@section Scripts
{


    @Scripts.Render(BundleConfig.NormalResultJavascriptBundleUrl)
}

