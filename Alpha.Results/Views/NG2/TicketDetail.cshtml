@{
    ViewBag.Title = Fanex.Products.ProductManager.GetProductName(Alpha.Results.Site.Constants.ProductIdConstants.NG2);
}

@model string

<div role="tabpanel" class="tab-pane active">
    <div class="filter">
        <iframe src="@Model" scrolling="auto" marginwidth="0" marginheight="0" allowtransparency="yes" width="100%" height="100%" frameborder="0"
                style="position: absolute; left: 0"></iframe>
    </div>
</div>
