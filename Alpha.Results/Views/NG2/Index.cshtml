@{
    ViewBag.Title = Fanex.Products.ProductManager.GetProductName(Alpha.Results.Site.Constants.ProductIdConstants.NG2);
    Layout = null;
}
@model string
<!DOCTYPE html>
<html class="ifr-result">
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@Html.Raw(ViewBag.Title)</title>
    @CN88.Web.Helpers.StaticResources.AssetStyles.Render("/bundles/site-results/default")
    @Styles.Render(BundleConfig.ResultCoreStyleBundleUrl)
</head>
<body class="ng2-container @(Html.Raw(CN88.Web.Helpers.BrowserManager.BuildMobileHtmlClass(true)))">
    <div id="page_main">
        <div class="container-fluid">
            @Html.Action("Index", "Tab", new { tabName = ViewContext.RouteData.Values["controller"], area = "" })
            <div class="tab-content">
                <div role="tabpanel" class="tab-pane active ng2">
                    <iframe src="@Model" scrolling="auto" marginwidth="0" marginheight="0" allowtransparency="yes" width="100%" height="100%" frameborder="0"></iframe>
                </div>
            </div>
        </div>
    </div>
    @Html.Hidden("RootURL", HttpContext.Current.Response.ApplyAppPathModifier("~/"))
    @CN88.Web.Helpers.StaticResources.AssetScripts.Render("/bundles/site-results/default")
</body>
</html>